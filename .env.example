# ============================================================================
# AI School Timetable Studio — Environment Configuration Example
# ============================================================================
# ملاحظة: هذا التطبيق يعمل بنظام BYOK (أحضر مفتاحك الخاص من واجهة المتصفح).
# لا يحتاج الخادم إلى أي مفاتيح Gemini افتراضية عند النشر العام.
# للاستخدام المحلي فقط يمكنك وضع إعدادات الخادم الاختيارية في ملف .env (غير متتبع في Git).

PORT=3000
NODE_ENV=development
GEMINI_MODEL=gemini-flash-lite-latest
